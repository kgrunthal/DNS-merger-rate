################################################################################
# model of FAST GPPS survey
################################################################################
  1.0  ! survey degradation factor
  16  ! antenna gain (K/Jy)
  300 ! integration time (s)
  .049152 ! sampling time (ms)
  20.  ! system temperature (K)
  1250 ! centre frequency (MHz)
  450  ! bandwidth (MHz)
  0.24414  ! channel bandwidth (MHz)
  2    ! number of polarizations
  3.  ! full-width half maximum (arcmin)
  0.   ! minimum RA (deg)
  360. ! maximum RA (deg)
 -0.9  ! minimum DEC (deg)
  52.2  ! maximum DEC (deg)
 30  ! minimum Galactic longitude (deg)
 90  ! maximum Galactic longitude (deg)
  0.   ! minimum abs(Galactic latitude) (deg)
  10.  ! maximum abs(Galactic latitude) (deg)
  1.0  ! fractional survey coverage (0-1)
  10.  ! signal-to-noise ratio
